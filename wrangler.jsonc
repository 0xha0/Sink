{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sink",
  "main": ".output/server/index.mjs",
  // This fork's deployment: s.gatsby.icu only (no workers.dev or preview URLs: they would bypass
  // the Cloudflare Access application on /dashboard, /api and /_docs)
  "routes": [{ "pattern": "s.gatsby.icu", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "NUXT_CF_ACCESS_TEAM_DOMAIN": "https://gatsby-icu.cloudflareaccess.com",
    "NUXT_CF_ACCESS_AUD": "54ea9623c6bd728082b25031b6b19a962547b08ba832184e8fa0864e84ce8125",
    // 302 + no-store: a deleted or expired link stops redirecting in browsers at once
    "NUXT_REDIRECT_STATUS_CODE": "302",
    "NUXT_REDIRECT_NO_STORE": "true",
    // no R2 bucket here, so no backups
    "NUXT_DISABLE_AUTO_BACKUP": "true"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public",
    "html_handling": "drop-trailing-slash"
  },
  "compatibility_date": "2025-05-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true,
  "upload_source_maps": true,
  "observability": {
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true
    }
  },
  // Values marked with DEPLOY_* below are placeholders for local/dev.
  // CLI deploy (pnpm deploy:worker / deploy:config) rewrites them into gitignored wrangler.deploy.jsonc.
  // Prefer setting DEPLOY_* in .env or Workers Builds / Pages variables — do not hardcode production IDs here.
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "sink" // Override with DEPLOY_ANALYTICS_DATASET (default: sink). Keep in sync with NUXT_DATASET at runtime.
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "preview_id": "ef93d42dc4b34969bab404d2e80f8dd3", // Override with DEPLOY_KV_PREVIEW_NAMESPACE_ID (falls back to DEPLOY_KV_NAMESPACE_ID)
      "id": "ef93d42dc4b34969bab404d2e80f8dd3" // Override with DEPLOY_KV_NAMESPACE_ID
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sink", // Override with DEPLOY_D1_DATABASE_NAME (default: sink)
      "database_id": "ef964055-65bf-4b78-b109-ac9c9290ae62", // Override with DEPLOY_D1_DATABASE_ID (required for CLI deploy)
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      // preview_bucket_name: DEPLOY_R2_PREVIEW_BUCKET_NAME (falls back to DEPLOY_R2_BUCKET_NAME)
      // omit DEPLOY_R2_BUCKET_NAME to drop R2 from generated deploy config
      "preview_bucket_name": "sink",
      "bucket_name": "sink" // Override with DEPLOY_R2_BUCKET_NAME
    }
  ]
}
